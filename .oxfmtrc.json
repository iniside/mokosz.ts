{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "ignorePatterns": [
    "data/raw/**",
    "data/embeddings/**",
    "data/invoices/**",
    "reports/**",
    ".stryker-tmp/**",
    "**/*.md",
    "**/*.yaml",
    "**/*.yml"
  ]
}
